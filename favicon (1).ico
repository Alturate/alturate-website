<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Book a Call — Alturate</title>
<meta name="description" content="Book a free discovery call with Alturate LLP for D365 F&O, Fabric/Power BI, ERP data readiness, automation, and AI readiness support.">
<meta name="theme-color" content="#0a0f1e">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#0a0f1e;--navy-mid:#0f1628;--navy-card:#1a2540;--gold:#c9a84c;--gold-light:#e8c97a;
  --white:#f4f6fb;--gray:#7a8899;--gray-light:#a8b4c4;--green:#10b981;--border:rgba(255,255,255,.08);
  --red:#ef4444;--blue:#60a5fa;
}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:'Plus Jakarta Sans',system-ui,-apple-system,Segoe UI,sans-serif;background:var(--navy);color:var(--white);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}a{color:inherit}.container{max-width:1180px;margin:0 auto;padding:0 28px}.nav{position:fixed;top:0;left:0;right:0;height:74px;background:rgba(10,15,30,.9);backdrop-filter:blur(24px);border-bottom:1px solid rgba(201,168,76,.12);z-index:50}.nav-inner{height:74px;display:flex;align-items:center;justify-content:space-between;max-width:1240px;margin:0 auto;padding:0 32px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-weight:800;letter-spacing:-.03em}.brand img{display:block;height:36px;width:auto;object-fit:contain}.brand-mark{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--gold),var(--gold-light));color:var(--navy);display:grid;place-items:center;font-weight:900}.brand small{display:block;font-size:.66rem;color:var(--gray-light);font-weight:600;letter-spacing:.04em;margin-top:-4px}.nav-links{display:flex;align-items:center;gap:34px;list-style:none}.nav-links a{font-size:.88rem;color:var(--gray-light);text-decoration:none;font-weight:600}.nav-links a:hover,.nav-links a.active{color:var(--white)}.nav-cta{background:var(--gold);color:var(--navy)!important;padding:10px 18px;border-radius:8px;font-weight:800!important}.nav-cta:hover{background:var(--gold-light)}.hero{padding:150px 0 88px;background:radial-gradient(circle at 78% 18%,rgba(201,168,76,.18),transparent 30%),radial-gradient(circle at 8% 12%,rgba(96,165,250,.12),transparent 28%)}.grid-2{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}.eyebrow{display:flex;align-items:center;gap:10px;font-size:.72rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-bottom:18px}.eyebrow:before{content:'';width:24px;height:2px;background:var(--gold);border-radius:2px}.hero h1,h1{font-size:clamp(2.6rem,5vw,4.7rem);line-height:1.06;letter-spacing:-.045em;font-weight:800;margin-bottom:22px}.gold-text{background:linear-gradient(120deg,var(--gold),var(--gold-light),var(--gold));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}.lead{font-size:1.13rem;color:var(--gray-light);max-width:680px;line-height:1.78;margin-bottom:30px}.cta-row{display:flex;gap:14px;flex-wrap:wrap;align-items:center}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;border-radius:10px;padding:14px 22px;font-weight:800;font-size:.92rem;border:1px solid transparent;cursor:pointer}.btn-primary{background:var(--gold);color:var(--navy)}.btn-primary:hover{background:var(--gold-light);box-shadow:0 12px 32px rgba(201,168,76,.22);transform:translateY(-1px)}.btn-ghost{color:var(--gray-light);border-color:rgba(255,255,255,.13);background:rgba(255,255,255,.02)}.btn-ghost:hover{border-color:rgba(201,168,76,.45);color:var(--gold-light)}.trust-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.pill{border:1px solid rgba(201,168,76,.18);background:rgba(201,168,76,.06);color:var(--gray-light);border-radius:999px;padding:9px 12px;font-size:.8rem;font-weight:650}.hero-card{background:linear-gradient(180deg,rgba(26,37,64,.95),rgba(15,22,40,.95));border:1px solid rgba(201,168,76,.16);border-radius:24px;padding:28px;box-shadow:0 24px 80px rgba(0,0,0,.25)}.score-card{display:grid;gap:14px}.score-line{display:flex;justify-content:space-between;gap:18px;padding:14px 0;border-bottom:1px solid var(--border)}.score-line:last-child{border-bottom:0}.score-line strong{font-size:.95rem}.score-line span{color:var(--gold);font-weight:800}.mini-note{font-size:.84rem;color:var(--gray);line-height:1.65;margin-top:18px}.section{padding:88px 0}.section-alt{background:var(--navy-mid)}.section-head{max-width:760px;margin-bottom:48px}.section-head h2,h2{font-size:clamp(2rem,3.7vw,3.1rem);line-height:1.12;letter-spacing:-.035em;margin-bottom:16px}.section-sub{font-size:1.05rem;color:var(--gray-light);line-height:1.75}.cards-3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.cards-2{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.card{background:var(--navy-card);border:1px solid var(--border);border-radius:18px;padding:28px;transition:.25s}.card:hover{border-color:rgba(201,168,76,.24);transform:translateY(-2px)}.card .tag{font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);font-weight:800;margin-bottom:12px}.card h3{font-size:1.18rem;letter-spacing:-.02em;margin-bottom:10px}.card p{color:var(--gray-light);font-size:.94rem;line-height:1.7}.card ul,.check-list{list-style:none;display:grid;gap:10px;margin-top:16px}.card li,.check-list li{color:var(--gray-light);font-size:.9rem;display:flex;gap:10px}.card li:before,.check-list li:before{content:'✓';color:var(--gold);font-weight:900;flex:0 0 auto}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.metric{background:rgba(255,255,255,.035);border:1px solid var(--border);border-radius:16px;padding:22px}.metric strong{display:block;font-size:1.55rem;color:var(--gold);margin-bottom:4px}.metric span{color:var(--gray-light);font-size:.86rem}.process{counter-reset:step;display:grid;gap:18px}.process-item{counter-increment:step;display:grid;grid-template-columns:58px 1fr;gap:18px;align-items:start;background:rgba(255,255,255,.035);border:1px solid var(--border);border-radius:16px;padding:22px}.process-item:before{content:counter(step);width:44px;height:44px;border-radius:12px;background:rgba(201,168,76,.1);color:var(--gold);display:grid;place-items:center;font-weight:900}.process-item h3{margin-bottom:6px}.process-item p{color:var(--gray-light)}.form-wrap{display:grid;grid-template-columns:1fr .8fr;gap:36px;align-items:start}.form-card{background:var(--navy-card);border:1px solid rgba(201,168,76,.14);border-radius:22px;padding:34px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.form-group{margin-bottom:16px}label{display:block;font-size:.76rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--gray-light);margin-bottom:8px}input,select,textarea{width:100%;background:rgba(10,15,30,.72);border:1px solid var(--border);color:var(--white);border-radius:10px;padding:13px 14px;font:inherit;font-size:.94rem}textarea{min-height:112px;resize:vertical}input:focus,select:focus,textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(201,168,76,.1)}select option{background:var(--navy-mid);color:var(--white)}.checkbox{display:flex;gap:10px;align-items:flex-start;margin:18px 0}.checkbox input{width:auto;margin-top:4px;accent-color:var(--gold)}.checkbox label{text-transform:none;letter-spacing:0;font-weight:500;color:var(--gray-light);font-size:.86rem;line-height:1.6}.hidden{display:none!important}.success{display:none;padding:24px;border-radius:16px;background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.22);margin-top:18px}.success h3{color:var(--green);margin-bottom:6px}.footer{background:#070b16;border-top:1px solid rgba(255,255,255,.06);padding:58px 0 34px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:36px;margin-bottom:38px}.footer p,.footer a{color:var(--gray);font-size:.88rem;text-decoration:none;line-height:1.8}.footer a:hover{color:var(--white)}.footer h4{font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin-bottom:14px}.footer ul{list-style:none;display:grid;gap:8px}.footer-bottom{border-top:1px solid rgba(255,255,255,.06);padding-top:22px;display:flex;justify-content:space-between;gap:16px;color:var(--gray);font-size:.8rem}.simple-page{padding:140px 0 82px}.content{max-width:900px}.content h2{font-size:1.6rem;margin-top:34px}.content p,.content li{color:var(--gray-light);line-height:1.78;margin:12px 0}.content ul{margin-left:20px}.quiz-card{background:var(--navy-card);border:1px solid rgba(201,168,76,.16);border-radius:24px;padding:34px;max-width:920px}.progress{height:10px;background:rgba(255,255,255,.08);border-radius:99px;overflow:hidden;margin:22px 0}.progress > div{height:100%;width:0;background:linear-gradient(90deg,var(--gold),var(--gold-light));transition:.25s}.options{display:grid;gap:12px;margin:22px 0}.option{display:flex;gap:12px;align-items:flex-start;padding:16px;border:1px solid var(--border);border-radius:14px;background:rgba(255,255,255,.025);cursor:pointer}.option:hover{border-color:rgba(201,168,76,.35)}.option input{width:auto;margin-top:4px}.result-box{background:rgba(201,168,76,.07);border:1px solid rgba(201,168,76,.2);border-radius:18px;padding:24px;margin:22px 0}.score-big{font-size:3rem;font-weight:900;color:var(--gold);line-height:1}.badge{display:inline-flex;border:1px solid rgba(201,168,76,.24);background:rgba(201,168,76,.08);color:var(--gold-light);border-radius:999px;padding:7px 11px;font-size:.78rem;font-weight:800}.table{width:100%;border-collapse:collapse;margin-top:20px}.table th,.table td{text-align:left;padding:14px;border-bottom:1px solid var(--border);color:var(--gray-light);font-size:.9rem}.table th{color:var(--gold);font-size:.76rem;text-transform:uppercase;letter-spacing:.08em}.notice{padding:16px 18px;border-radius:14px;border:1px solid rgba(96,165,250,.2);background:rgba(96,165,250,.07);color:var(--gray-light);margin:18px 0}.mobile-only{display:none}
@media(max-width:900px){.nav-inner{padding:0 20px}.nav-links{display:none}.mobile-only{display:block}.hero{padding-top:126px}.grid-2,.form-wrap,.cards-2{grid-template-columns:1fr}.cards-3{grid-template-columns:1fr 1fr}.metric-grid{grid-template-columns:1fr 1fr}.footer-grid{grid-template-columns:1fr 1fr}.footer-bottom{flex-direction:column}.hero-card{order:-1}.section{padding:68px 0}}
@media(max-width:620px){.container{padding:0 20px}.cards-3,.metric-grid,.form-row,.footer-grid{grid-template-columns:1fr}.hero h1,h1{font-size:2.45rem}.section-head h2,h2{font-size:2rem}.cta-row .btn{width:100%}.process-item{grid-template-columns:1fr}.form-card,.quiz-card{padding:22px}}
</style>
<link rel="icon" type="image/png" sizes="64x64" href="data:image/png;base64,">
<link rel="shortcut icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">

</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <a class="brand" href="index.html" aria-label="Alturate home">
      <img src="data:image/png;base64," alt="Alturate">
    </a>
    <ul class="nav-links">
      <li><a class="" href="index.html">Home</a></li>
      <li><a class="" href="services.html">Services</a></li>
      <li><a class="" href="assessment.html">AI Readiness Score</a></li>
      <li><a class="" href="about.html">About</a></li>
      <li><a class="nav-cta active" href="contact.html">Book a Call →</a></li>
    </ul>
    <a class="mobile-only btn btn-primary" href="contact.html" style="padding:9px 12px;font-size:.78rem">Book</a>
  </div>
</nav>


<header class="hero">
  <div class="container">
    <div class="eyebrow">Get in touch</div>
    <h1>Book a free <span class="gold-text">30-minute discovery call.</span></h1>
    <p class="lead">Tell us what is happening with your Dynamics 365 F&O environment, reporting, automation, or AI readiness. We will respond within one business day.</p>
  </div>
</header>

<section class="section section-alt">
  <div class="container form-wrap">
    <div class="form-card">
      <h2 style="font-size:1.65rem">Book Your Free Call</h2>
      <p class="mini-note" style="margin-bottom:24px">Use this form for D365 F&O, Fabric/Power BI, ERP data readiness, workflow automation, or AI/Copilot readiness enquiries.</p>
      <form id="contactForm" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="6413159c-9e3a-48e1-9225-8b4ed8974247">
        <input type="hidden" name="from_name" value="Alturate LLP Contact Form">
        <input type="hidden" name="subject" value="New Alturate LLP Website Enquiry">
        <input type="hidden" name="redirect" value="https://alturate.com/thank-you.html">
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off">
        <div class="form-row">
          <div class="form-group"><label for="firstName">First Name *</label><input id="firstName" name="First Name" required placeholder="John"></div>
          <div class="form-group"><label for="lastName">Last Name *</label><input id="lastName" name="Last Name" required placeholder="Smith"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="email">Work Email *</label><input id="email" type="email" name="email" required placeholder="you@company.com"></div>
          <div class="form-group"><label for="company">Company Name *</label><input id="company" name="Company" required placeholder="Company name"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="size">Company Size *</label><select id="size" name="Company Size" required><option value="">Select size</option><option>50–150 employees</option><option>151–500 employees</option><option>501–1000 employees</option><option>1000+ employees</option></select></div>
          <div class="form-group"><label for="service">I need help with *</label><select id="service" name="Service Needed" required><option value="">Select service</option><option>D365 AI & Data Readiness Assessment</option><option>D365 + Fabric / Power BI Reporting Modernization</option><option>D365 F&O Support Retainer</option><option>Workflow / Approval / Power Automate Automation</option><option>Integration or Data Issue</option><option>Not sure yet</option></select></div>
        </div>
        <div class="form-group"><label for="challenge">Biggest challenge right now *</label><select id="challenge" name="Main Challenge" required><option value="">Select your main challenge</option><option>ERP data is messy or unreliable</option><option>Power BI reports are slow, wrong, or failing</option><option>Too many manual Excel/process workarounds</option><option>Current D365 support partner is slow</option><option>We want to evaluate Copilot/AI but are not ready</option><option>We need D365 F&O integration or automation help</option><option>Something else</option></select></div>
        <div class="form-group"><label for="message">Anything else we should know?</label><textarea id="message" name="Message" placeholder="Briefly describe the issue, system, timeline, or goal."></textarea></div>
        <div class="checkbox"><input id="consent" type="checkbox" name="Consent" value="Agreed" required><label for="consent">I agree to be contacted by Alturate LLP about my enquiry. We do not sell your information. Read our <a href="privacy.html">Privacy Policy</a>.</label></div>
        <button class="btn btn-primary" type="submit" style="width:100%">Book My Free Call →</button>
        <p class="mini-note" style="text-align:center">We respond within one business day. Do not submit passwords, production data, or confidential ERP files through this form.</p>
      </form>
    </div>
    <aside>
      <div class="card"><h3>Prefer email?</h3><p>Send a short note to <a href="mailto:hello@alturate.com" style="color:var(--gold)">hello@alturate.com</a>. For partner or subcontracting enquiries, use subject line “Partner Enquiry”.</p></div>
      <div class="card" style="margin-top:18px"><h3>What happens next</h3><ul><li>You submit the form</li><li>We review the fit</li><li>We send a calendar link</li><li>We discuss your D365/Fabric/AI readiness problem</li><li>You get a recommended next step</li></ul></div>
      <div class="card" style="margin-top:18px"><h3>Good fit problems</h3><p>D365 F&O reporting pain, Fabric/Power BI issues, ERP data readiness, manual workflows, integrations, approvals, and practical AI/Copilot readiness.</p></div>
    </aside>
  </div>
</section>


<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="index.html"><img src="data:image/png;base64," alt="Alturate"></a>
        <p style="margin-top:16px;max-width:360px">Microsoft Dynamics 365 F&O, ERP data readiness, Fabric/Power BI reporting, automation, and practical AI readiness services for global mid-market businesses.</p>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="services.html#readiness">D365 AI & Data Readiness</a></li>
          <li><a href="services.html#fabric">Fabric Reporting Modernization</a></li>
          <li><a href="services.html#automation">Workflow & Automation</a></li>
          <li><a href="services.html#managed">Managed Support</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="about.html">About Alturate</a></li>
          <li><a href="assessment.html">AI Readiness Score</a></li>
          <li><a href="privacy.html">Privacy Policy</a></li>
          <li><a href="contact.html">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:hello@alturate.com">hello@alturate.com</a></li>
          <li><a href="contact.html">Book a Free Call</a></li>
          <li><a href="https://www.linkedin.com/company/alturate" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Alturate LLP. All rights reserved.</p>
      <p style="color:var(--gold)">Dynamics 365 F&O • Fabric • ERP AI Readiness</p>
    </div>
  </div>
</footer>

</body>
</html>
